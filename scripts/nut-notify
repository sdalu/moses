#!/bin/sh
#
# nut-notify -- NUT NOTIFYCMD: forward a UPS event to MQTT.
# NUT invokes it as `nut-notify "<message>"` with $NOTIFYTYPE / $UPSNAME set
# in the environment, and publishes twice:
#   ups/<ups>/notify/<type>   the message, not retained -- an event
#   ups/<ups>/state           the type, retained -- the current state
# See the comments at the foot of this file for why those are separate.
#
set -u

: "${MOSQUITTO_PUB:=/usr/bin/mosquitto_pub}"
: "${UPSC:=/usr/bin/upsc}"
: "${MOSES_CONFIG:=/root/moses/config.yaml}"

# Read one key from the yaml config. This is slow, so it is only used as a
# fallback below when the corresponding MQTT_* variable is not already set.
yaml() { yq -r "$1" "$MOSES_CONFIG" 2>/dev/null; }

# Prefer MQTT_* from the environment; otherwise read the config file. With the
# variables exported (e.g. from the moses environment) yq is never invoked.
MQTT_HOST="${MQTT_HOST:-$(yaml '.[":mqtt"][":host"]')}"
MQTT_PORT="${MQTT_PORT:-$(yaml '.[":mqtt"][":port"]')}"
MQTT_USERNAME="${MQTT_USERNAME:-$(yaml '.[":mqtt"][":username"]')}"
MQTT_PASSWORD="${MQTT_PASSWORD:-$(yaml '.[":mqtt"][":password"]')}"

# yq prints "null" for missing keys; treat that as unset.
for v in MQTT_HOST MQTT_PORT MQTT_USERNAME MQTT_PASSWORD ; do
    eval "[ \"\$$v\" = null ] && $v="
done

# Nothing to publish to without a broker.
[ -n "$MQTT_HOST" ] || { echo "${0##*/}: no MQTT host configured" >&2; exit 1; }

: "${UPSNAME:=unknown}" "${NOTIFYTYPE:=unknown}"

# Publish once, on the common arguments. A non-empty third argument
# asks for the message to be retained.
publish() { # <topic> <payload> [retain]
    "$MOSQUITTO_PUB"                           \
        -h "$MQTT_HOST"                        \
        ${MQTT_PORT:+-p "$MQTT_PORT"}          \
        ${MQTT_USERNAME:+-u "$MQTT_USERNAME"}  \
        ${MQTT_PASSWORD:+-P "$MQTT_PASSWORD"}  \
        ${3:+-r}                               \
        -t "$1" -m "$2"
}

# The event: one topic per notification type, carrying upsmon's own
# message. Not retained -- an event is a thing that happened, and a
# subscriber arriving later has not had it happen to them.
publish "ups/${UPSNAME}/notify/${NOTIFYTYPE}" "${1:-}"

# The state: one topic, retained. This is what lets something that was
# not running at the time find out where the UPS stands -- a display
# started an hour later, or on another machine entirely, gets it the
# moment it subscribes.
#
# It has to be its own topic rather than a retain flag on the event
# above: the type is part of that topic, so retaining there would leave
# a retained message per type -- ONLINE *and* ONBATT both delivered on
# subscribe, in no defined order and with no timestamps, and no way to
# tell which is the current one.
#
# What it carries is ups.status, asked of upsd, and not the notification
# type. A type names a transition and is a poor stand-in for a state;
# COMMOK shows that plainly, since it says communications came back and
# says nothing about whether the mains did. Publishing the type there
# would have a restart during a power cut leave the panel reading "on
# line" while the house ran on its battery.
#
# The type is the fallback for when upsd cannot be asked, which is
# better than nothing and is at least right for ONLINE and ONBATT.
state=$("$UPSC" "$UPSNAME" ups.status 2>/dev/null) || state=
publish "ups/${UPSNAME}/state" "${state:-$NOTIFYTYPE}" retain
